# AXIS Web Frontend Configuration
# Leave these blank for local development; Vite proxies same-origin requests
# to the backend on 127.0.0.1:8000.
VITE_API_URL=
VITE_WS_URL=
VITE_AXIS_API_KEY=
# Demo fallback is safe for local development and is clearly labelled in the UI.
# Set this to false in production so unavailable live data remains unavailable.
VITE_ENABLE_MOCK_FALLBACK=true
# Local development falls back automatically. Set this only for strict
# live-only debugging; production builds are strict by default.
VITE_STRICT_LIVE_DATA=false

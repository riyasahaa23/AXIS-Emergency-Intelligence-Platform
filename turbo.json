{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },

    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".svelte-kit/**"
      ]
    },

    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },

    "lint": {
      "outputs": []
    },

    "typecheck": {
      "outputs": []
    }
  }
}
